# ============================================================
# AquaGuard AI — Environment Variables Template
# Copy this file to .env and fill in your values.
# NEVER commit the actual .env file.
# ============================================================

# Application
APP_NAME=AquaGuard AI
APP_ENV=development
DEBUG=true
SECRET_KEY=your-very-long-secret-key-here-change-in-production

# Backend Server
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000

# Frontend
VITE_API_URL=http://localhost:8000
VITE_WS_URL=ws://localhost:8000

# Database (PostgreSQL)
DATABASE_URL=postgresql+asyncpg://aquaguard:password@localhost:5432/aquaguard_db
DB_HOST=localhost
DB_PORT=5432
DB_NAME=aquaguard_db
DB_USER=aquaguard
DB_PASSWORD=your-db-password-here

# JWT Authentication
JWT_SECRET_KEY=your-jwt-secret-key-here
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# AI / Computer Vision
YOLO_MODEL=yolov8n.pt
YOLO_CONFIDENCE=0.5
YOLO_IOU=0.45
TRACKER=bytetrack

# Temporal Model
TEMPORAL_MODEL=lstm
SEQUENCE_LENGTH=32
TEMPORAL_CONFIDENCE=0.8
ALERT_CONSECUTIVE_FRAMES=5

# Alert Engine
ALERT_COOLDOWN_SECONDS=30

# File Upload
MAX_UPLOAD_SIZE_MB=500
UPLOAD_DIR=./uploads

# Logging
LOG_LEVEL=INFO
LOG_FILE=./logs/aquaguard.log

# Optional: Redis (for future use)
# REDIS_URL=redis://localhost:6379

# Optional: Email Notifications
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your-email@gmail.com
# SMTP_PASSWORD=your-app-password

# Optional: Telegram Bot
# TELEGRAM_BOT_TOKEN=your-bot-token
# TELEGRAM_CHAT_ID=your-chat-id

# Optional: ESP32 IoT
# IOT_MQTT_BROKER=localhost
# IOT_MQTT_PORT=1883
# IOT_MQTT_TOPIC=aquaguard/alert

# CORS
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
